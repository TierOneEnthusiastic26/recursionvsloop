#include <iostream>
using namespace std;

int fib(int n);

int main()
{
    int n,fibonacci=1;
    cout<<"Enter a number: ";
    cin>>n;
    fibonacci=fib(n);
    cout<<"Fibonacci value of "<<n<<" is "<<fibonacci;

    return 0;
}

int fib(int n)
{
    if (n==1)
    return 0;
    
    else if (n==2)
    return 1;

    else
    {
        int a=0,b=1,c;

        for (int i=3;i<=n;i++)
        {
            c=a+b;
            a=b;
            b=c;

        }

        return b;
    }

}
